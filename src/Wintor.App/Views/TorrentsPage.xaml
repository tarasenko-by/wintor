<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Wintor.App.Views.TorrentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Wintor.App.Views"
    xmlns:vm="using:Wintor.App.ViewModels"
    AllowDrop="True"
    DragOver="Page_DragOver"
    Drop="Page_Drop">

    <Grid Padding="24,12,24,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header: title, total speed, commands  -->
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Uid="TorrentsTitle" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.TotalSpeedText, Mode=OneWay}"
                    TextWrapping="NoWrap" />
            </StackPanel>
            <!--  Takes the remaining width so commands move into the "…" overflow on narrow windows.  -->
            <CommandBar
                Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Background="Transparent"
                DefaultLabelPosition="Right"
                IsDynamicOverflowEnabled="True">
                <AppBarButton x:Uid="AddMagnetButton" Click="AddMagnet_Click">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE71B;" />
                    </AppBarButton.Icon>
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton x:Uid="OpenFileButton" Click="OpenFile_Click">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE8E5;" />
                    </AppBarButton.Icon>
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="O" Modifiers="Control" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton x:Uid="ResumeButton" Command="{x:Bind ViewModel.ResumeCommand}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE768;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Uid="PauseButton" Command="{x:Bind ViewModel.PauseCommand}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE769;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton
                    x:Uid="RemoveButton"
                    Click="Remove_Click"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE74D;" />
                    </AppBarButton.Icon>
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="Delete" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
            </CommandBar>
        </Grid>

        <InfoBar
            Grid.Row="1"
            IsOpen="{x:Bind local:TorrentsPage.HasText(ViewModel.ErrorMessage), Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            Severity="Error" />

        <ProgressRing
            Grid.Row="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

        <!--  Empty state  -->
        <StackPanel
            Grid.Row="2"
            MaxWidth="360"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
            <FontIcon
                FontSize="48"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Glyph="&#xE896;" />
            <TextBlock
                x:Uid="EmptyTitle"
                HorizontalAlignment="Center"
                Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock
                x:Uid="EmptyHint"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Button
                x:Uid="EmptyAddButton"
                HorizontalAlignment="Center"
                Click="AddMagnet_Click"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>

        <ListView
            x:Uid="TorrentList"
            Grid.Row="2"
            Padding="0,0,0,24"
            ItemsSource="{x:Bind ViewModel.Torrents, Mode=OneTime}"
            SelectedItem="{x:Bind ViewModel.SelectedTorrent, Mode=TwoWay}"
            SelectionMode="Single"
            Visibility="{x:Bind ViewModel.HasTorrents, Mode=OneWay}">
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="Margin" Value="0,0,0,4" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:TorrentItemViewModel">
                    <Border
                        Padding="16,12"
                        AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource OverlayCornerRadius}">
                        <Grid ColumnSpacing="16" RowSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind Name, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}" />
                            <TextBlock
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind SpeedText, Mode=OneWay}" />

                            <ProgressBar
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                                ShowError="{x:Bind IsError, Mode=OneWay}"
                                ShowPaused="{x:Bind IsPaused, Mode=OneWay}"
                                Value="{x:Bind ProgressPercent, Mode=OneWay}" />

                            <StackPanel
                                Grid.Row="2"
                                Orientation="Horizontal"
                                Spacing="16">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind StatusText, Mode=OneWay}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind SizeText, Mode=OneWay}" />
                            </StackPanel>
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind PeersText, Mode=OneWay}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>

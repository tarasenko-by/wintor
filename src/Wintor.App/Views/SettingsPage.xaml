<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Wintor.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls">

    <ScrollViewer>
        <StackPanel
            MaxWidth="1000"
            Padding="24,12,24,24"
            Spacing="4">
            <TextBlock
                x:Uid="SettingsTitle"
                Margin="0,0,0,16"
                Style="{StaticResource TitleTextBlockStyle}" />

            <TextBlock
                x:Uid="SettingsDownloadsHeader"
                Margin="0,8,0,4"
                Style="{StaticResource BodyStrongTextBlockStyle}" />
            <toolkit:SettingsCard x:Uid="DownloadFolderCard" Description="{x:Bind ViewModel.DownloadDirectory, Mode=OneWay}">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8B7;" />
                </toolkit:SettingsCard.HeaderIcon>
                <Button x:Uid="ChangeFolderButton" Click="ChangeFolder_Click" />
            </toolkit:SettingsCard>

            <TextBlock
                x:Uid="SettingsAboutHeader"
                Margin="0,24,0,4"
                Style="{StaticResource BodyStrongTextBlockStyle}" />
            <toolkit:SettingsExpander x:Uid="AboutCard" Description="{x:Bind ViewModel.Version, Mode=OneTime}">
                <toolkit:SettingsExpander.HeaderIcon>
                    <BitmapIcon ShowAsMonochrome="False" UriSource="ms-appx:///Assets/StoreLogo.png" />
                </toolkit:SettingsExpander.HeaderIcon>
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard x:Uid="LicenseCard" />
                    <toolkit:SettingsCard x:Uid="EngineCard" />
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</Page>

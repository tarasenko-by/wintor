<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Wintor.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!--  After the Fluent resources so its brushes win. Services/Appearance finds it by file name.  -->
                <ResourceDictionary Source="ms-appx:///Themes/Palette.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Window roots: solid palette background, cleared to transparent while a backdrop is on.  -->
            <Style x:Key="WindowBackgroundStyle" TargetType="Grid">
                <Setter Property="Background" Value="{ThemeResource AppWindowBackgroundBrush}" />
            </Style>

            <!--  Content dialogs pick up the default style (WinUI otherwise keeps the old one for dialogs made in code).  -->
            <Style BasedOn="{StaticResource DefaultContentDialogStyle}" TargetType="ContentDialog" />

            <!--  Torrent and detail cards  -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
                <Setter Property="Padding" Value="16,12" />
            </Style>

            <!--
                Progress bars: a 16 px bar with 4 px corners on a grey track that fills with color, instead of Fluent's 1 px line
                with a 3 px indicator (too thin to read in a table). Lightweight resources, so every ProgressBar in the
                app follows; the track color comes from the Background below.
            -->
            <!--
                The command bar's "…" button as wide as its icon buttons (68), so all hover highlights match.
                Its style reads these from the application, so they cannot live on the CommandBar.
            -->
            <x:Double x:Key="AppBarExpandButtonThemeWidth">68</x:Double>
            <Thickness x:Key="AppBarEllipsisButtonInnerBorderMargin">2,6,2,6</Thickness>

            <x:Double x:Key="ProgressBarTrackHeight">16</x:Double>
            <x:Double x:Key="ProgressBarMinHeight">16</x:Double>
            <CornerRadius x:Key="ProgressBarCornerRadius">4</CornerRadius>
            <CornerRadius x:Key="ProgressBarTrackCornerRadius">4</CornerRadius>
            <Style BasedOn="{StaticResource DefaultProgressBarStyle}" TargetType="ProgressBar">
                <Setter Property="Background" Value="{ThemeResource ProgressTrackBrush}" />
                <Setter Property="MinHeight" Value="16" />
            </Style>

            <Style x:Key="SectionHeaderStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
                <Setter Property="Margin" Value="2,24,0,6" />
                <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
            </Style>

            <Style x:Key="PageTitleStyle" BasedOn="{StaticResource TitleTextBlockStyle}" TargetType="TextBlock">
                <Setter Property="AutomationProperties.HeadingLevel" Value="Level1" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>

            <Style x:Key="SecondaryCaptionStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="TertiaryCaptionStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

<?xml version="1.0" encoding="utf-8" ?>
<!--
    Wintor's solid palette: Tailwind zinc neutrals instead of the Fluent defaults (translucent layers over a
    wallpaper-tinted backdrop). This is the default look; Mica or Acrylic can be turned on in Settings
    (Services/Appearance.cs). The accent stays the user's Windows accent. High contrast keeps the system colors.
    To try another neutral family (gray, slate, neutral, stone), change only the Zinc* colors.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Tailwind zinc  -->
    <Color x:Key="Zinc50">#FAFAFA</Color>
    <Color x:Key="Zinc100">#F4F4F5</Color>
    <Color x:Key="Zinc200">#E4E4E7</Color>
    <Color x:Key="Zinc300">#D4D4D8</Color>
    <Color x:Key="Zinc400">#A1A1AA</Color>
    <Color x:Key="Zinc500">#71717A</Color>
    <Color x:Key="Zinc600">#52525B</Color>
    <Color x:Key="Zinc700">#3F3F46</Color>
    <Color x:Key="Zinc800">#27272A</Color>
    <Color x:Key="Zinc900">#18181B</Color>
    <Color x:Key="Zinc950">#09090B</Color>

    <!--  The title bar keeps the app icon at full strength in an inactive window (WinUI halves it).  -->
    <x:Double x:Key="TitleBarDeactivatedOpacity">1</x:Double>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <!--  Window and layers  -->
            <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="{StaticResource Zinc100}" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource Zinc50}" />
            <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="White" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{StaticResource Zinc50}" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="{StaticResource Zinc200}" />

            <!--
                Layer under the pages. Solid: clear, so pages lie on the shell's zinc-50 layer above. With a backdrop
                (Services/Appearance swaps the brushes' colors to the *Translucent ones) the shell layer clears, so the
                navigation pane lies on Mica/Acrylic, and pages get a translucent white. Cards keep their solid paper.
            -->
            <Color x:Key="ShellLayerTranslucentColor">Transparent</Color>
            <SolidColorBrush x:Key="ContentLayerBrush" Color="Transparent" />
            <Color x:Key="ContentLayerTranslucentColor">#80FFFFFF</Color>
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource Zinc100}" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="{StaticResource Zinc200}" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="{StaticResource Zinc50}" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="White" />

            <!--  Cards and strokes  -->
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="White" />
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="{StaticResource Zinc50}" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource Zinc200}" />
            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="{StaticResource Zinc200}" />
            <SolidColorBrush x:Key="ControlAltFillColorTertiaryBrush" Color="{StaticResource Zinc100}" />

            <!--  Text  -->
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource Zinc900}" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource Zinc600}" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource Zinc500}" />

            <!--  Status: red-600, amber-600, green-600  -->
            <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#DC2626" />
            <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#D97706" />
            <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#16A34A" />

            <!--  Torrent progress: downloading green-600, seeding blue-600, paused / stopped zinc-400  -->
            <SolidColorBrush x:Key="TorrentDownloadingBrush" Color="#16A34A" />
            <SolidColorBrush x:Key="TorrentSeedingBrush" Color="#2563EB" />
            <SolidColorBrush x:Key="TorrentInactiveBrush" Color="{StaticResource Zinc400}" />
            <!--  The empty part of progress and piece bars  -->
            <SolidColorBrush x:Key="ProgressTrackBrush" Color="{StaticResource Zinc200}" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="{StaticResource Zinc950}" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="{StaticResource Zinc900}" />
            <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="{StaticResource Zinc800}" />
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="{StaticResource Zinc900}" />
            <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="{StaticResource Zinc800}" />

            <!--  Layer under the pages (see Light): zinc-700 at 30 % over the dark backdrop.  -->
            <Color x:Key="ShellLayerTranslucentColor">Transparent</Color>
            <SolidColorBrush x:Key="ContentLayerBrush" Color="Transparent" />
            <Color x:Key="ContentLayerTranslucentColor">#4C3F3F46</Color>
            <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="{StaticResource Zinc950}" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="{StaticResource Zinc950}" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="{StaticResource Zinc900}" />
            <SolidColorBrush x:Key="SolidBackgroundFillColorQuarternaryBrush" Color="{StaticResource Zinc800}" />

            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource Zinc800}" />
            <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="{StaticResource Zinc900}" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource Zinc700}" />
            <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="{StaticResource Zinc800}" />
            <SolidColorBrush x:Key="ControlAltFillColorTertiaryBrush" Color="{StaticResource Zinc800}" />

            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource Zinc100}" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource Zinc300}" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource Zinc400}" />

            <!--  Status: red-400, amber-400, green-400  -->
            <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#F87171" />
            <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#FBBF24" />
            <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#4ADE80" />

            <!--  Torrent progress: green-500, blue-500, zinc-500  -->
            <SolidColorBrush x:Key="TorrentDownloadingBrush" Color="#22C55E" />
            <SolidColorBrush x:Key="TorrentSeedingBrush" Color="#3B82F6" />
            <SolidColorBrush x:Key="TorrentInactiveBrush" Color="{StaticResource Zinc500}" />
            <SolidColorBrush x:Key="ProgressTrackBrush" Color="{StaticResource Zinc700}" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="AppWindowBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TorrentDownloadingBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="TorrentSeedingBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="TorrentInactiveBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="ProgressTrackBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <!--  No transparency in high contrast: pages lie on the system window color.  -->
            <SolidColorBrush x:Key="ContentLayerBrush" Color="Transparent" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>

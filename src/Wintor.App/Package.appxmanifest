<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 uap10 com desktop rescap">

  <!--  The Microsoft Store identity from Partner Center (Product identity); the Store re-signs the package.  -->
  <Identity
    Name="SiarheiTarasenka.Wintor-TorrentClient"
    Publisher="CN=80472E69-09D4-42FB-AC2D-A07586A834F7"
    Version="0.2.0.0" />

  <mp:PhoneIdentity PhoneProductId="F28EBC3D-BBCD-4C21-9760-297D0F2BBA80" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <!--  The Store name reserved in Partner Center; Start, the taskbar and the title bar say just "Wintor".  -->
    <DisplayName>Wintor - Torrent Client</DisplayName>
    <PublisherDisplayName>Siarhei Tarasenka</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:PackageIntegrity>
      <uap10:Content Enforcement="on"/>
    </uap10:PackageIntegrity>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26226.0" />
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26226.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="Wintor"
        Description="Modern open-source BitTorrent client for Windows"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
      <Extensions>
        <!--  Double-clicking a .torrent file opens it in Wintor (once chosen as the default app).  -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="torrent">
            <uap:DisplayName>BitTorrent file</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType ContentType="application/x-bittorrent">.torrent</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <!--  magnet: links in a browser open the add dialog.  -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="magnet">
            <uap:DisplayName>Magnet link</uap:DisplayName>
          </uap:Protocol>
        </uap:Extension>
        <!--  "wintor" in a terminal: opens the app; "wintor - -quit" (two dashes) quits a running Wintor gracefully.  -->
        <uap5:Extension Category="windows.appExecutionAlias" Executable="Wintor.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="wintor.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
        <!--  Optional start at sign-in, turned on in Settings; starts in the notification area.  -->
        <uap5:Extension Category="windows.startupTask">
          <uap5:StartupTask TaskId="WintorStartup" Enabled="false" DisplayName="Wintor" />
        </uap5:Extension>
        <!--  Clicking a notification (or its button) activates Wintor through this COM class.  -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="Wintor.exe" Arguments="----AppNotificationActivated:" DisplayName="Wintor">
              <com:Class Id="8D21B584-E7ED-4E5C-AC4E-EF84F6188B26" DisplayName="Wintor notifications" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
        <desktop:Extension Category="windows.toastNotificationActivation">
          <desktop:ToastNotificationActivation ToastActivatorCLSID="8D21B584-E7ED-4E5C-AC4E-EF84F6188B26" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>

<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Wintor.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:icons="using:Wintor.App.Icons"
    Title="Wintor">

    <!--  Background: Services/Appearance (solid palette by default, Mica/Acrylic if chosen in Settings).  -->
    <Grid x:Name="RootGrid" Style="{StaticResource WindowBackgroundStyle}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator
                Key="F"
                Invoked="FocusSearch_Invoked"
                Modifiers="Control" />
        </Grid.KeyboardAccelerators>

        <TitleBar
            x:Name="AppTitleBar"
            Title="Wintor"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="AppTitleBar_PaneToggleRequested"
            SizeChanged="AppTitleBar_SizeChanged">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <!--  As wide as the Mail app's search; narrower windows shrink it (AppTitleBar_SizeChanged).  -->
                <AutoSuggestBox
                    x:Name="SearchBox"
                    x:Uid="SearchBox"
                    Width="440"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="SearchBox"
                    PreviewKeyDown="SearchBox_PreviewKeyDown"
                    QueryIcon="{icons:Huge Kind=Search01}"
                    TextChanged="SearchBox_TextChanged" />
            </TitleBar.Content>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            OpenPaneLength="260"
            PaneDisplayMode="Left"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="NavAll"
                    x:Uid="NavAllItem"
                    AutomationProperties.AutomationId="NavTorrents"
                    Icon="{icons:Huge Kind=GridView}"
                    Tag="filter:All">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="NavAllText" TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource TertiaryCaptionStyle}"
                            Text="{x:Bind Torrents.AllCount, Mode=OneWay}" />
                    </Grid>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Uid="NavDownloadingItem"
                    AutomationProperties.AutomationId="NavDownloading"
                    Icon="{icons:Huge Kind=Download01}"
                    Tag="filter:Downloading">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="NavDownloadingText" TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource TertiaryCaptionStyle}"
                            Text="{x:Bind Torrents.DownloadingCount, Mode=OneWay}" />
                    </Grid>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Uid="NavCompletedItem"
                    AutomationProperties.AutomationId="NavCompleted"
                    Icon="{icons:Huge Kind=CheckmarkCircle01}"
                    Tag="filter:Completed">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="NavCompletedText" TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource TertiaryCaptionStyle}"
                            Text="{x:Bind Torrents.CompletedCount, Mode=OneWay}" />
                    </Grid>
                </NavigationViewItem>
                <NavigationViewItem
                    x:Uid="NavPausedItem"
                    AutomationProperties.AutomationId="NavPaused"
                    Icon="{icons:Huge Kind=Pause}"
                    Tag="filter:Paused">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="NavPausedText" TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource TertiaryCaptionStyle}"
                            Text="{x:Bind Torrents.PausedCount, Mode=OneWay}" />
                    </Grid>
                </NavigationViewItem>
                <NavigationViewItemHeader x:Name="LabelsHeader" x:Uid="NavLabelsHeader" />
                <!--  Label items follow, added from Torrents.Labels (SyncLabelItems).  -->
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" Navigated="ContentFrame_Navigated" />
        </NavigationView>
    </Grid>
</Window>
